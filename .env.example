# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (score sync + leaderboard)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# AWS Bedrock (optional AI context analysis)
# Use either a Bedrock API key, or standard AWS credentials.
BEDROCK_API_KEY=
BEDROCK_REGION=us-west-2
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS Cognito (sign-in). VITE_ vars are bundled into the renderer.
VITE_COGNITO_REGION=eu-north-1
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_CLIENT_SECRET=
