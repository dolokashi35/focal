# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# API Gateway URL (set after deployment)
API_GATEWAY_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/dev

# SageMaker Endpoint (set after model deployment)
SAGEMAKER_ENDPOINT=focus-ai-dev-endpoint

# S3 Configuration
S3_BUCKET_NAME=focus-ai-dev-data

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=focus-ai-dev-events

# Cognito Configuration
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_IDENTITY_POOL_ID=us-west-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Application Configuration
USER_ID=anonymous
AUTO_LAUNCH=true
SCREENSHOT_INTERVAL=30000
BATCH_INTERVAL=20000

# Development Configuration
NODE_ENV=development
DEBUG=true


